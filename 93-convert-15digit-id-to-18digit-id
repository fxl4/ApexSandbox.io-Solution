public String convert15to18DigitId(String fifteenDigit)
{
    Integer result = fifteenDigit.length();
    Id recordId;
    String eighteenDigit;
    if (result == 15) {
        recordId = fifteenDigit;
        eighteenDigit = String.valueOf(recordId);
        return eighteenDigit;
    } else if (result == null) {
        return result;
    } else {
        eighteenDigit = '-1';
        return eighteenDigit;
    }
}